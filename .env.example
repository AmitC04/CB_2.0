# Required for live Phase 2 extraction. Never commit a real key.
# Gemini free-tier content may be used by Google to improve its products.
# This project sends synthetic documents only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Local defaults used by Docker Compose
DATABASE_PATH=/app/data/jeevansetu.db
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional bearer-token gate. Empty means the API is open, which is correct for the
# loopback-only demo and wrong anywhere else. See docs/DEPLOYMENT.md before hosting.
API_TOKEN=
# Only used when NEXT_PUBLIC_API_URL is /api/backend, so the token stays server-side.
BACKEND_URL=http://backend:8000
# Shared credential for a hosted frontend. Checked on every request, proxy included.
# Leave empty for the local demo. render.yaml sets these automatically.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# true makes the frontend refuse traffic when the credential above is missing.
PUBLIC_DEPLOYMENT=
# true seeds the demo when the database comes up empty. For hosts with no disk.
SEED_ON_STARTUP=
